qubits 7
gate M0[4](y, x) = eq(x, 15) * eq(y, 15) + (1 - eq(x, 15)) * eq(y, mod(1 * x, 15))
gate M1[4](y, x) = eq(x, 15) * eq(y, 15) + (1 - eq(x, 15)) * eq(y, mod(4 * x, 15))
gate M2[4](y, x) = eq(x, 15) * eq(y, 15) + (1 - eq(x, 15)) * eq(y, mod(2 * x, 15))
state(b) = eq(b, 1)
apply H on 0
apply ctrl(M0) on 0, 3, 4, 5, 6
apply H on 1
apply ctrl(M1) on 1, 3, 4, 5, 6
apply H on 2
apply ctrl(M2) on 2, 3, 4, 5, 6
apply adj(SWAP) on 0, 2
apply adj(H) on 2
apply adj(ctrl(Phase[pi / 2])) on 2, 1
apply adj(H) on 1
apply adj(ctrl(Phase[pi / 4])) on 2, 0
apply adj(ctrl(Phase[pi / 2])) on 1, 0
apply adj(H) on 0
show probs
